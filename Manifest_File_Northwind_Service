{
    "_version": "1.84.0",
    "$schema": "https://raw.githubusercontent.com/SAP/ui5-manifest/v1.84.0/schema.json",

    "sap.app": {
        "id": "com.diva.invoices",
        "type": "card",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },

    "sap.card": {
        "type": "List",

        "configuration": {
            "destinations": {
                "MyDestination": {
                    "name": "NorthWind",
                    "defaultUrl": "https://services.odata.org"
                }
            }
        },

        "header": {
            "title": "Invoices to be Processed",
            "subTitle": "Please process the following",
            "icon": {
                "src": "sap-icon://sales-document"
            }
        },

        "data": {
            "request": {
                "url": "{{destinations.MyDestination}}/V3/Northwind/Northwind.svc/Invoices",
                "method": "GET",
                "mode": "cors",
                "parameters": {
                    "$format": "json"
                }
            },
            "path": "/value"
        },

        "content": {
            "item": {
                "icon": {
                    "src": "sap-icon://wrench"
                },

                "title": {
                    "value": "{CustomerID}, {CustomerName}"
                },

                "description": {
                    "value": "{ProductID}, {ProductName}"
                },

                "info": {
                    "value": "{UnitPrice}",
                    "state": "None"
                },

                "highlight": "{= ${UnitPrice} < 42 ? 'Success' : 'Warning' }"
            }
        }
    }
}

